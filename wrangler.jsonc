{
  "name": "fox-test-builds-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "ALLOWED_ORIGIN": "http://localhost:8080" },
  "r2_buckets": [{ "binding": "BUILDS", "bucket_name": "fox-test-builds" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fox-test-builds",
      "database_id": "REPLACE_AFTER_D1_CREATE",
    },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
